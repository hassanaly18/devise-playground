<div class="mt-6 pt-6 border-t border-zinc-900 flex flex-col gap-2.5 text-center">
  <%- if controller_name != 'sessions' %>
    <%= link_to "Already have an account? Log in", new_session_path(resource_name), class: "text-[11px] font-mono tracking-wider uppercase text-zinc-500 hover:text-white transition-colors" %>
  <% end %>

  <%- if devise_mapping.registerable? && controller_name != 'registrations' %>
    <%= link_to "Create an account", new_registration_path(resource_name), class: "text-[11px] font-mono tracking-wider uppercase text-zinc-500 hover:text-white transition-colors" %>
  <% end %>

  <%- if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
    <%= link_to "Forgot your password?", new_password_path(resource_name), class: "text-[11px] font-mono tracking-wider uppercase text-zinc-500 hover:text-white transition-colors" %>
  <% end %>

  <%- if devise_mapping.confirmable? && controller_name != 'confirmations' %>
    <%= link_to "Didn't receive confirmation instructions?", new_confirmation_path(resource_name), class: "text-[11px] font-mono tracking-wider uppercase text-zinc-550 hover:text-white transition-colors" %>
  <% end %>

  <%- if devise_mapping.lockable? && resource_class.unlock_strategy_enabled?(:email) && controller_name != 'unlocks' %>
    <%= link_to "Didn't receive unlock instructions?", new_unlock_path(resource_name), class: "text-[11px] font-mono tracking-wider uppercase text-zinc-550 hover:text-white transition-colors" %>
  <% end %>

  <%- if devise_mapping.omniauthable? %>
    <%- resource_class.omniauth_providers.each do |provider| %>
      <%= button_to "Sign in with #{OmniAuth::Utils.camelize(provider)}", omniauth_authorize_path(resource_name, provider), data: { turbo: false }, class: "text-[11px] font-mono tracking-wider uppercase text-zinc-400 hover:text-white transition-colors cursor-pointer" %>
    <% end %>
  <% end %>
</div>
