<div class="max-w-2xl mx-auto w-full space-y-8 animate-fade-in text-left">
  <!-- Heading Section -->
  <div class="space-y-2 text-center md:text-left">
    <p class="text-[10px] tracking-widest text-zinc-500 font-mono uppercase">User Settings</p>
    <h1 class="text-3xl font-light tracking-tight text-white">Edit Profile Details</h1>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
    <!-- Main Update Settings Form -->
    <div class="md:col-span-2 border border-zinc-900 bg-zinc-900/10 backdrop-blur-sm rounded-2xl p-6 shadow-2xl shadow-black/40">
      <h3 class="text-xs font-mono font-bold tracking-widest text-zinc-400 uppercase mb-6 pb-2 border-b border-zinc-900">
        Profile Settings
      </h3>

      <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <div class="space-y-5">
          <!-- Username Field -->
          <div class="space-y-1.5">
            <%= f.label :username, class: "text-[10px] tracking-widest text-zinc-455 font-mono uppercase" %>
            <%= f.text_field :username, autofocus: true, class: "w-full bg-zinc-950/60 border border-zinc-900 focus:border-zinc-750 focus:ring-1 focus:ring-zinc-800 rounded-lg px-4 py-3 text-sm text-zinc-200 focus:outline-none transition-all duration-200" %>
          </div>

          <!-- Email Field -->
          <div class="space-y-1.5">
            <%= f.label :email, class: "text-[10px] tracking-widest text-zinc-455 font-mono uppercase" %>
            <%= f.email_field :email, autocomplete: "email", class: "w-full bg-zinc-950/60 border border-zinc-900 focus:border-zinc-750 focus:ring-1 focus:ring-zinc-800 rounded-lg px-4 py-3 text-sm text-zinc-200 focus:outline-none transition-all duration-200" %>
          </div>

          <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
            <div class="text-[11px] font-mono text-zinc-400 border border-zinc-900 bg-zinc-950/40 p-2.5 rounded-lg">
              Waiting confirmation for: <span class="text-white"><%= resource.unconfirmed_email %></span>
            </div>
          <% end %>

          <!-- New Password Field -->
          <div class="space-y-1.5">
            <div class="flex justify-between items-baseline">
              <%= f.label :password, "New Password", class: "text-[10px] tracking-widest text-zinc-455 font-mono uppercase" %>
              <span class="text-[9px] text-zinc-550 font-mono tracking-wider">(leave blank to keep current)</span>
            </div>
            <%= f.password_field :password, autocomplete: "new-password", placeholder: "••••••••", class: "w-full bg-zinc-950/60 border border-zinc-900 focus:border-zinc-750 focus:ring-1 focus:ring-zinc-800 rounded-lg px-4 py-3 text-sm text-zinc-200 placeholder-zinc-800 focus:outline-none transition-all duration-200" %>
            <% if @minimum_password_length %>
              <p class="text-[9px] text-zinc-600 font-mono tracking-wide mt-1"><%= @minimum_password_length %> characters minimum</p>
            <% end %>
          </div>

          <!-- Password Confirmation Field -->
          <div class="space-y-1.5">
            <%= f.label :password_confirmation, "Confirm New Password", class: "text-[10px] tracking-widest text-zinc-455 font-mono uppercase" %>
            <%= f.password_field :password_confirmation, autocomplete: "new-password", placeholder: "••••••••", class: "w-full bg-zinc-950/60 border border-zinc-900 focus:border-zinc-750 focus:ring-1 focus:ring-zinc-800 rounded-lg px-4 py-3 text-sm text-zinc-200 placeholder-zinc-800 focus:outline-none transition-all duration-200" %>
          </div>

          <!-- Current Password Field -->
          <div class="space-y-1.5 pt-2 border-t border-zinc-900">
            <div class="flex justify-between items-baseline">
              <%= f.label :current_password, class: "text-[10px] tracking-widest text-zinc-455 font-mono uppercase font-bold" %>
              <span class="text-[9px] text-zinc-550 font-mono tracking-wider">(required to save changes)</span>
            </div>
            <%= f.password_field :current_password, autocomplete: "current-password", placeholder: "••••••••", class: "w-full bg-zinc-950/60 border border-zinc-900 focus:border-zinc-750 focus:ring-1 focus:ring-zinc-800 rounded-lg px-4 py-3 text-sm text-zinc-200 placeholder-zinc-800 focus:outline-none transition-all duration-200" %>
          </div>

          <!-- Submit Button -->
          <div class="pt-4">
            <%= f.submit "Update Profile", class: "w-full cursor-pointer text-xs font-semibold uppercase tracking-wider text-zinc-950 bg-white hover:bg-zinc-200 py-3.5 rounded-lg transition-all duration-200 shadow-lg shadow-white/5" %>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Danger Zone Side Panel -->
    <div class="border border-zinc-950 bg-zinc-950/40 rounded-2xl p-6 shadow-xl flex flex-col justify-between h-fit self-start space-y-6">
      <div>
        <h3 class="text-xs font-mono font-bold tracking-widest text-zinc-400 uppercase mb-4 pb-2 border-b border-zinc-900">
          Danger Zone
        </h3>
        <p class="text-xs text-zinc-500 leading-relaxed font-mono">
          Permanently cancel and delete your Devise Playground account. This action is completely irreversible.
        </p>
      </div>

      <div>
        <%= button_to registration_path(resource_name), data: { confirm: "Are you sure?", turbo_confirm: "Are you sure?" }, method: :delete, class: "w-full text-center cursor-pointer text-[10px] font-mono font-bold uppercase tracking-wider text-zinc-400 hover:text-red-400 bg-zinc-900 hover:bg-red-950/20 border border-zinc-800 hover:border-red-950/80 py-3 rounded-lg transition-all duration-200" do %>
          Cancel Account
        <% end %>
      </div>
    </div>
  </div>

  <!-- Back Link -->
  <div class="text-center md:text-left">
    <%= link_to :back, class: "inline-flex items-center gap-1.5 text-xs text-zinc-500 hover:text-white transition-colors group" do %>
      <span class="transition-transform group-hover:-translate-x-0.5">←</span>
      <span class="font-mono uppercase tracking-wider text-[10px]">Go Back</span>
    <% end %>
  </div>
</div>
