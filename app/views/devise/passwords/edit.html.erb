<div class="max-w-md mx-auto w-full animate-fade-in">
  <div class="border border-zinc-900 bg-zinc-900/10 backdrop-blur-sm rounded-2xl p-8 shadow-2xl shadow-black/40">
    <!-- Header -->
    <div class="mb-8 space-y-2 text-center">
      <p class="text-[10px] tracking-widest text-zinc-500 font-mono uppercase">Password Reset</p>
      <h2 class="text-2xl font-light tracking-tight text-white">Change Password</h2>
    </div>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>
      <%= f.hidden_field :reset_password_token %>

      <div class="space-y-5">
        <!-- New Password Field -->
        <div class="space-y-1.5 text-left">
          <div class="flex justify-between items-baseline">
            <%= f.label :password, "New password", class: "text-[10px] tracking-widest text-zinc-455 font-mono uppercase" %>
            <% if @minimum_password_length %>
              <span class="text-[9px] text-zinc-550 font-mono tracking-wider lowercase">(<%= @minimum_password_length %> chars min)</span>
            <% end %>
          </div>
          <%= f.password_field :password, autofocus: true, autocomplete: "new-password", placeholder: "••••••••", class: "w-full bg-zinc-950/60 border border-zinc-900 focus:border-zinc-750 focus:ring-1 focus:ring-zinc-800 rounded-lg px-4 py-3 text-sm text-zinc-200 placeholder-zinc-700 focus:outline-none transition-all duration-200" %>
        </div>

        <!-- Password Confirmation Field -->
        <div class="space-y-1.5 text-left">
          <%= f.label :password_confirmation, "Confirm new password", class: "text-[10px] tracking-widest text-zinc-455 font-mono uppercase" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password", placeholder: "••••••••", class: "w-full bg-zinc-950/60 border border-zinc-900 focus:border-zinc-750 focus:ring-1 focus:ring-zinc-800 rounded-lg px-4 py-3 text-sm text-zinc-200 placeholder-zinc-700 focus:outline-none transition-all duration-200" %>
        </div>

        <!-- Submit Button -->
        <div class="pt-2">
          <%= f.submit "Change password", class: "w-full cursor-pointer text-xs font-semibold uppercase tracking-wider text-zinc-950 bg-white hover:bg-zinc-200 py-3.5 rounded-lg transition-all duration-200 shadow-lg shadow-white/5" %>
        </div>
      </div>
    <% end %>

    <!-- Shared Links -->
    <%= render "devise/shared/links" %>
  </div>
</div>
