<div class="max-w-xl mx-auto w-full space-y-8 animate-fade-in">
  <!-- Heading Section -->
  <div class="space-y-2 text-center md:text-left">
    <p class="text-[10px] tracking-widest text-zinc-500 font-mono uppercase">Dashboard Overview</p>
    <h1 class="text-3xl font-light tracking-tight text-white">
      Welcome back, <span class="font-normal text-zinc-200"><%= current_user.username.presence || "Friend" %></span>
    </h1>
  </div>

  <!-- Profile Details Card -->
  <div class="border border-zinc-900 bg-zinc-900/20 backdrop-blur-sm rounded-xl p-6 space-y-6">
    <div class="flex items-center justify-between border-b border-zinc-900 pb-4">
      <span class="text-xs tracking-wider text-zinc-400 font-mono uppercase">Account Information</span>
      <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-mono font-medium tracking-wide uppercase border border-zinc-800 bg-zinc-950 text-zinc-400">
        <%= current_user.role %>
      </span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="space-y-1">
        <p class="text-[10px] tracking-widest text-zinc-500 font-mono uppercase">Email Address</p>
        <p class="text-sm font-medium text-zinc-350"><%= current_user.email %></p>
      </div>

      <div class="space-y-1">
        <p class="text-[10px] tracking-widest text-zinc-500 font-mono uppercase">Member Since</p>
        <p class="text-sm font-medium text-zinc-350"><%= current_user.created_at.strftime("%B %d, %Y") %></p>
      </div>
    </div>
  </div>

  <!-- Action Controls -->
  <div class="flex flex-col sm:flex-row gap-4 justify-start items-center">
    <%= link_to edit_user_registration_path, class: "w-full sm:w-auto text-center text-xs font-medium uppercase tracking-wider text-zinc-300 hover:text-white bg-zinc-900 border border-zinc-800 hover:bg-zinc-800 px-5 py-3 rounded-lg transition-all duration-200" do %>
      Edit Profile Settings
    <% end %>

    <% if policy(User).index? %>
      <%= link_to admin_dashboard_path, class: "w-full sm:w-auto text-center text-xs font-medium uppercase tracking-wider text-zinc-950 bg-white hover:bg-zinc-200 px-5 py-3 rounded-lg transition-all duration-200" do %>
        Enter Admin Control Panel
      <% end %>
    <% end %>
  </div>
  <!-- Stimulus Interactive Demos Section -->
  <div class="pt-6 border-t border-zinc-900/60 space-y-6">
    <div class="space-y-1">
      <p class="text-[10px] tracking-widest text-zinc-500 font-mono uppercase">Interactive Playground</p>
      <h2 class="text-lg font-light text-white">Stimulus Controller Integrations</h2>
    </div>

    <!-- Hello Controller Demo -->
    <div data-controller="hello" class="border border-zinc-900 bg-zinc-900/10 backdrop-blur-sm rounded-xl p-6 space-y-4">
      <div class="flex items-center justify-between border-b border-zinc-900 pb-3">
        <span class="text-[11px] font-mono tracking-wider text-zinc-400 uppercase">Console Greeter</span>
        <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[9px] font-mono tracking-wider uppercase border border-zinc-800 bg-zinc-950 text-zinc-400">
          Hello Controller
        </span>
      </div>

      <div class="space-y-3">
        <p class="text-xs text-zinc-450 leading-relaxed font-mono">
          Enter a value below to output a custom greeting directly to your browser's developer console.
        </p>
        <div class="flex flex-col sm:flex-row gap-3">
          <input data-hello-target="name" type="text" placeholder="Type a name..." class="flex-grow bg-zinc-950 border border-zinc-900 focus:border-zinc-700 focus:ring-1 focus:ring-zinc-850 rounded-lg px-4 py-2.5 text-xs text-zinc-200 placeholder-zinc-800 focus:outline-none transition-all duration-200">
          <button data-action="click->hello#greet" class="cursor-pointer text-xs font-mono font-bold uppercase tracking-wider text-zinc-950 bg-white hover:bg-zinc-200 px-5 py-2.5 rounded-lg transition-all duration-200 shrink-0">
            Greet
          </button>
        </div>
      </div>
    </div>

    <!-- Clipboard Controller Demos -->
    <div class="border border-zinc-900 bg-zinc-900/10 backdrop-blur-sm rounded-xl p-6 space-y-6">
      <div class="flex items-center justify-between border-b border-zinc-900 pb-3">
        <span class="text-[11px] font-mono tracking-wider text-zinc-400 uppercase">Secure Credentials</span>
        <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[9px] font-mono tracking-wider uppercase border border-zinc-800 bg-zinc-950 text-zinc-400">
          Clipboard Controller
        </span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Clipboard 1 -->
        <div data-controller="clipboard" data-clipboard-supported-class="clipboard--supported" class="space-y-2">
          <label class="text-[10px] tracking-widest text-zinc-500 font-mono uppercase">Pin Credentials 1</label>
          <div class="flex gap-2">
            <input data-clipboard-target="source" type="text" value="1234" readonly class="flex-grow bg-zinc-950/60 border border-zinc-900 rounded-lg px-3 py-2 text-xs font-mono text-zinc-400 focus:outline-none">
            <button data-action="clipboard#copy" class="clipboard-button cursor-pointer text-[10px] font-mono font-bold uppercase tracking-wider text-zinc-300 hover:text-white bg-zinc-900 border border-zinc-800 hover:bg-zinc-800 px-4 py-2 rounded-lg transition-all duration-200 shrink-0">
              Copy
            </button>
          </div>
        </div>

        <!-- Clipboard 2 -->
        <div data-controller="clipboard" data-clipboard-supported-class="clipboard--supported" class="space-y-2">
          <label class="text-[10px] tracking-widest text-zinc-500 font-mono uppercase">Pin Credentials 2</label>
          <div class="flex gap-2">
            <input data-clipboard-target="source" type="text" value="9876" readonly class="flex-grow bg-zinc-950/60 border border-zinc-900 rounded-lg px-3 py-2 text-xs font-mono text-zinc-400 focus:outline-none">
            <a href="#" data-action="clipboard#copy" class="clipboard-button cursor-pointer text-center text-[10px] font-mono font-bold uppercase tracking-wider text-zinc-300 hover:text-white bg-zinc-900 border border-zinc-800 hover:bg-zinc-800 px-4 py-2.5 rounded-lg transition-all duration-200 shrink-0 flex items-center justify-center">
              Copy Link
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Slideshow Controller Demo -->
    <div data-controller="slideshow" data-slideshow-index-value="0" class="border border-zinc-900 bg-zinc-900/10 backdrop-blur-sm rounded-xl p-6 space-y-6">
      <div class="flex items-center justify-between border-b border-zinc-900 pb-3">
        <span class="text-[11px] font-mono tracking-wider text-zinc-400 uppercase">State Carousel</span>
        <div class="flex items-center gap-2">
          <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[9px] font-mono tracking-wider uppercase border border-zinc-800 bg-zinc-950 text-zinc-400 mr-2">
            Slideshow Controller
          </span>
          <button data-action="slideshow#previous" class="cursor-pointer flex items-center justify-center w-7 h-7 rounded-md bg-zinc-900 hover:bg-zinc-800 border border-zinc-800 text-zinc-400 hover:text-white transition-all duration-200">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
          </button>
          <button data-action="slideshow#next" class="cursor-pointer flex items-center justify-center w-7 h-7 rounded-md bg-zinc-900 hover:bg-zinc-800 border border-zinc-800 text-zinc-400 hover:text-white transition-all duration-200">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
          </button>
        </div>
      </div>

      <div class="relative bg-zinc-950/40 border border-zinc-900/80 rounded-lg p-8 flex flex-col items-center justify-center min-h-[140px] overflow-hidden select-none">
        <div class="absolute inset-0 bg-gradient-to-b from-zinc-900/20 to-transparent pointer-events-none"></div>

        <div data-slideshow-target="slide" class="flex flex-col items-center space-y-2 z-10">
          <span class="text-5xl animate-bounce">🐵</span>
          <span class="text-[10px] tracking-widest text-zinc-550 font-mono uppercase">Slide 1 of 4</span>
        </div>
        <div data-slideshow-target="slide" class="flex flex-col items-center space-y-2 z-10" hidden>
          <span class="text-5xl animate-pulse">🙈</span>
          <span class="text-[10px] tracking-widest text-zinc-550 font-mono uppercase">Slide 2 of 4</span>
        </div>
        <div data-slideshow-target="slide" class="flex flex-col items-center space-y-2 z-10" hidden>
          <span class="text-5xl">🙉</span>
          <span class="text-[10px] tracking-widest text-zinc-550 font-mono uppercase">Slide 3 of 4</span>
        </div>
        <div data-slideshow-target="slide" class="flex flex-col items-center space-y-2 z-10" hidden>
          <span class="text-5xl">🙊</span>
          <span class="text-[10px] tracking-widest text-zinc-550 font-mono uppercase">Slide 4 of 4</span>
        </div>
      </div>
    </div>
  </div>
</div>