# Ignore bundler config.

/.bundle

# Ignore all environment files containing secrets.

/.env
/.env.*
!.env.example

# Ignore Byebug command history file.

.byebug_history

# Ignore local configuration.

config/master.key
config/credentials/*.key

# Ignore Kamal secrets.

.kamal/secrets*

# Ignore database files.

/db/*.sqlite3
/db/*.sqlite3-*
/db/*.sqlite3-journal

# Ignore log files and tempfiles.

/log/*
!/log/.keep
/tmp/*
!/tmp/.keep

# Ignore pidfiles, but keep the directory.

/tmp/pids/*
!/tmp/pids/
/tmp/pids/.keep

# Ignore storage (Active Storage local files).

/storage/*
!/storage/.keep

# Ignore uploaded files if using local uploads.

/public/uploads

# Ignore asset builds.

/public/assets
/public/packs
/public/packs-test
/node_modules

# Ignore generated frontend assets.

/app/assets/builds/*
!/app/assets/builds/.keep

# Ignore Bootsnap cache.

/tmp/cache
/tmp/bootsnap*

# Ignore RubyMine project files.

.idea

# Ignore VS Code settings.

.vscode

# Ignore Sublime Text files.

*.sublime-project
*.sublime-workspace

# Ignore macOS files.

.DS_Store

# Ignore Linux temporary files.

*~

# Ignore swap files.

*.swp
*.swo

# Ignore test coverage reports.

/coverage

# Ignore profiling and benchmarking files.

*.stackprof

# Ignore Yard documentation.

.yardoc
_yardoc
doc/

# Ignore RSpec status file.

.rspec_status

# Ignore Capybara screenshots.

/tmp/screenshots

# Ignore Brakeman output.

brakeman.html

# Ignore Ruby version managers.

.ruby-gemset

# Ignore generated SSL certificates.

config/ssl/*.key
config/ssl/*.crt

# Ignore Docker overrides.

docker-compose.override.yml

# Ignore Kamal runtime artifacts.

.kamal/hooks/*.local

# Ignore local mail previews if using Letter Opener.

/tmp/letter_opener

# Ignore local Active Job files.

tmp/storage

# Ignore generated error dumps.

*.rbc
*.sassc

# Ignore language server caches.

.solargraph
.ruby-lsp

# Ignore dotenv files.

.env.local
.env.development.local
.env.test.local
.env.production.local
